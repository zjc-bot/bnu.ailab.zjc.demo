# 复制为 register/.env 后填写；真实 .env 不得提交。
# 秘密项刻意留空。SECRET_KEY 至少使用 32 字节随机值，缺失时应用拒绝启动。
SECRET_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=studentapp
DB_PASSWORD=
DB_NAME=school

SMTP_HOST=smtp.mail.bnu.edu.cn
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=BNU AI Lab

# 本地经 SSH 隧道访问；HTTPS 公网部署时改为真实站点地址并设 COOKIE_SECURE=1。
SITE_URL=http://127.0.0.1:8082
COOKIE_SECURE=0

AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
